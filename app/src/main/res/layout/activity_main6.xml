<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity6">

    <TextView
        android:id="@+id/labelTrans"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transport"
        android:textSize="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/textTransport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        tools:text="WiFi"
        android:textSize="20dp"
        app:layout_constraintTop_toTopOf="@+id/labelTrans"
        app:layout_constraintStart_toEndOf="@+id/labelTrans"
        />

    <TextView
        android:id="@+id/labelIpAdress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="IPアドレス"
        android:textSize="20dp"
        app:layout_constraintTop_toBottomOf="@+id/labelTrans"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/textIpAdress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="20dp"
        tools:text="192.168.100.100/24"
        app:layout_constraintTop_toBottomOf="@+id/labelIpAdress"
        app:layout_constraintStart_toStartOf="@+id/labelIpAdress"
        />

    <Button
        android:id="@+id/buttonIP"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="読み込み"
        android:textSize="20dp"
        app:layout_constraintTop_toBottomOf="@+id/textIpAdress"
        app:layout_constraintStart_toStartOf="@+id/labelIpAdress"
        />
</androidx.constraintlayout.widget.ConstraintLayout>