<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity3">

    <TextView
        android:id="@+id/result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="35dp"
        android:textSize="40dp"
        android:text="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        />

    <Button
        android:id="@+id/button0"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginEnd="7dp"
        android:text="0"
        app:layout_constraintTop_toTopOf="@+id/button_plus"
        app:layout_constraintEnd_toStartOf="@id/button_equal"
        app:layout_constraintStart_toEndOf="@+id/button_AC"
        />

    <Button
        android:id="@+id/button1"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginEnd="7dp"
        android:text="1"
        app:layout_constraintTop_toTopOf="@+id/button_sub"
        app:layout_constraintEnd_toStartOf="@+id/button2"
        app:layout_constraintStart_toStartOf="parent"
        />

    <Button
        android:id="@+id/button2"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginEnd="7dp"
        android:text="2"
        app:layout_constraintTop_toTopOf="@+id/button_sub"
        app:layout_constraintEnd_toStartOf="@+id/button3"
        app:layout_constraintStart_toEndOf="@+id/button1"
        />

    <Button
        android:id="@+id/button3"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginEnd="7dp"
        android:text="3"
        app:layout_constraintTop_toTopOf="@+id/button_sub"
        app:layout_constraintEnd_toStartOf="@+id/button_sub"
        app:layout_constraintStart_toEndOf="@+id/button2"
        />

    <Button
        android:id="@+id/button4"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginEnd="7dp"
        android:text="4"
        app:layout_constraintTop_toTopOf="@+id/button_multi"
        app:layout_constraintEnd_toStartOf="@+id/button5"
        app:layout_constraintStart_toStartOf="parent"
        />

    <Button
        android:id="@+id/button5"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginEnd="4dp"
        android:text="5"
        app:layout_constraintEnd_toStartOf="@+id/button6"
        app:layout_constraintTop_toTopOf="@+id/button_multi"
        app:layout_constraintStart_toEndOf="@+id/button4"
        />

    <Button
        android:id="@+id/button6"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginEnd="7dp"
        android:text="6"
        app:layout_constraintTop_toTopOf="@+id/button_multi"
        app:layout_constraintEnd_toStartOf="@+id/button_multi"
        app:layout_constraintStart_toEndOf="@+id/button5"
        />

    <Button
        android:id="@+id/button7"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginEnd="7dp"
        android:text="7"
        app:layout_constraintTop_toTopOf="@+id/button_div"
        app:layout_constraintEnd_toStartOf="@+id/button8"
        app:layout_constraintStart_toStartOf="parent"
        />

    <Button
        android:id="@+id/button8"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginEnd="7dp"
        android:text="8"
        app:layout_constraintTop_toTopOf="@+id/button_div"
        app:layout_constraintEnd_toStartOf="@+id/button9"
        app:layout_constraintStart_toEndOf="@+id/button7"
        />

    <Button
        android:id="@+id/button9"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginEnd="7dp"
        android:text="9"
        app:layout_constraintTop_toTopOf="@+id/button_div"
        app:layout_constraintEnd_toStartOf="@+id/button_div"
        app:layout_constraintStart_toEndOf="@+id/button8"
        />

    <Button
        android:id="@+id/button_div"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_margin="7dp"
        android:text="÷"
        app:layout_constraintTop_toBottomOf="@id/result"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button9"
        />

    <Button
        android:id="@+id/button_multi"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_margin="7dp"
        android:text="×"
        app:layout_constraintTop_toBottomOf="@+id/button_div"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button6"
    />

    <Button
        android:id="@+id/button_sub"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_margin="7dp"
        android:text="-"
        app:layout_constraintTop_toBottomOf="@+id/button_multi"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button3"
        />

    <Button
        android:id="@+id/button_plus"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_margin="7dp"
        android:text="+"
        app:layout_constraintTop_toBottomOf="@+id/button_sub"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button_equal"
        />

    <Button
        android:id="@+id/button_equal"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginEnd="7dp"
        android:text="="
        app:layout_constraintTop_toTopOf="@+id/button_plus"
        app:layout_constraintEnd_toStartOf="@id/button_plus"
        app:layout_constraintStart_toEndOf="@+id/button0"
        />

    <Button
        android:id="@+id/button_AC"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginEnd="7dp"
        android:text="AC"
        app:layout_constraintTop_toTopOf="@+id/button_plus"
        app:layout_constraintEnd_toStartOf="@id/button0"
        app:layout_constraintStart_toStartOf="parent"
        />







</androidx.constraintlayout.widget.ConstraintLayout>